<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>gov.usps</groupId>
	<artifactId>eems_batch</artifactId>
	<packaging>jar</packaging>

	<name>eems_batch</name>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
	</properties>

	<dependencies>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>4.12</version>
		</dependency>
		<dependency>
			<groupId>gov.usps.eems</groupId>
			<artifactId>ojdbc6</artifactId>
			<version>1.0.0</version>
		</dependency>
		<dependency>
			<groupId>gov.usps.eems</groupId>
			<artifactId>oraclepki</artifactId>
			<version>1.0.0</version>
		</dependency>
		<dependency>
			<groupId>gov.usps.eems</groupId>
			<artifactId>osdt_cert</artifactId>
			<version>1.0.0</version>
		</dependency>
		<dependency>
			<groupId>gov.usps.eems</groupId>
			<artifactId>osdt_core</artifactId>
			<version>1.0.0</version>
		</dependency>
		<dependency>
			<groupId>gov.usps.eems</groupId>
			<artifactId>ucp</artifactId>
			<version>1.0.0</version>
		</dependency>
		<dependency>
			<groupId>gov.usps.eems</groupId>
			<artifactId>obix</artifactId>
			<version>1.0.0</version>
		</dependency>

		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-log4j12</artifactId>
			<version>1.7.25</version>
		</dependency>

		<dependency>
			<groupId>org.apache.httpcomponents</groupId>
			<artifactId>httpclient</artifactId>
			<version>4.5.3</version>
		</dependency>

		<dependency>
			<groupId>javax.mail</groupId>
			<artifactId>mail</artifactId>
			<version>1.4.7</version>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
			<version>1.7.25</version>
		</dependency>

	</dependencies>
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.6.2</version>
				<configuration>
					<source>1.6</source>
					<target>1.6</target>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-assembly-plugin</artifactId>
				<version>3.1.0</version>
				<configuration>

					<archive>
						<manifest>
							<addClasspath>true</addClasspath>
							<addDefaultImplementationEntries>true</addDefaultImplementationEntries>
							<addDefaultSpecificationEntries>true</addDefaultSpecificationEntries>
							<mainClass>gov.usps.eems.App</mainClass>
						</manifest>
					</archive>
					<descriptors>
						<descriptor>src/assembly/assembly.xml</descriptor>
					</descriptors>

				</configuration>
				<executions>
					<execution>

						<id>create-archive</id>
						<phase>package</phase>
						<goals>
							<goal>single</goal>
						</goals>

					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-install-plugin</artifactId>
				<version>2.5.2</version>
				<executions>
					<execution>
						<id>install-ojdbc6</id>
						<phase>clean</phase>
						<configuration>
							<file>${basedir}/src/main/lib/ojdbc6.jar</file>
							<repositoryLayout>default</repositoryLayout>
							<groupId>gov.usps.eems</groupId>
							<artifactId>ojdbc6</artifactId>
							<version>1.0.0</version>
							<packaging>jar</packaging>
							<generatePom>true</generatePom>
						</configuration>
						<goals>
							<goal>install-file</goal>
						</goals>
					</execution>
					<execution>
						<id>install-oraclepki</id>
						<phase>clean</phase>
						<configuration>
							<file>${basedir}/src/main/lib/oraclepki.jar</file>
							<repositoryLayout>default</repositoryLayout>
							<groupId>gov.usps.eems</groupId>
							<artifactId>oraclepki</artifactId>
							<version>1.0.0</version>
							<packaging>jar</packaging>
							<generatePom>true</generatePom>
						</configuration>
						<goals>
							<goal>install-file</goal>
						</goals>
					</execution>
					<execution>
						<id>install-osdt_cert</id>
						<phase>clean</phase>
						<configuration>
							<file>${basedir}/src/main/lib/osdt_cert.jar</file>
							<repositoryLayout>default</repositoryLayout>
							<groupId>gov.usps.eems</groupId>
							<artifactId>osdt_cert</artifactId>
							<version>1.0.0</version>
							<packaging>jar</packaging>
							<generatePom>true</generatePom>
						</configuration>
						<goals>
							<goal>install-file</goal>
						</goals>
					</execution>
					<execution>
						<id>install-osdt_core</id>
						<phase>clean</phase>
						<configuration>
							<file>${basedir}/src/main/lib/osdt_core.jar</file>
							<repositoryLayout>default</repositoryLayout>
							<groupId>gov.usps.eems</groupId>
							<artifactId>osdt_core</artifactId>
							<version>1.0.0</version>
							<packaging>jar</packaging>
							<generatePom>true</generatePom>
						</configuration>
						<goals>
							<goal>install-file</goal>
						</goals>
					</execution>
					<execution>
						<id>install-ucp</id>
						<phase>clean</phase>
						<configuration>
							<file>${basedir}/src/main/lib/ucp.jar</file>
							<repositoryLayout>default</repositoryLayout>
							<groupId>gov.usps.eems</groupId>
							<artifactId>ucp</artifactId>
							<version>1.0.0</version>
							<packaging>jar</packaging>
							<generatePom>true</generatePom>
						</configuration>
						<goals>
							<goal>install-file</goal>
						</goals>
					</execution>
					<execution>
						<id>install-obix</id>
						<phase>clean</phase>
						<configuration>
							<file>${basedir}/src/main/lib/obix.jar</file>
							<repositoryLayout>default</repositoryLayout>
							<groupId>gov.usps.eems</groupId>
							<artifactId>obix</artifactId>
							<version>1.0.0</version>
							<packaging>jar</packaging>
							<generatePom>true</generatePom>
						</configuration>
						<goals>
							<goal>install-file</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
	<version>0.0.1-SNAPSHOT</version>

</project>
