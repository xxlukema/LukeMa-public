<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="com.learn.persistence.bean" default-lazy="true" default-cascade="all-delete-orphan">
   <class name="User" table="Users" >
      <id name="id" type="long" column="id">
         <generator class="native">
            <param name="sequence">User_Id_Seq</param>
         </generator>
      </id>
      
      <property name="username" length="60" unique="true" not-null="true" />

      <property name="password" length="20" not-null="true" />
      
      <property name="email" length="60" unique="true" not-null="true" />
      
      <property name="remoteAddress" length="20" not-null="true" />
      
      <property name="stockList" length="300" />
      
      <property name="dateCreated" type="java.util.Date" not-null="true" />
      
      <property name="dateUpdated" type="java.util.Date" not-null="true" />
   </class>
   
   <query name="findUserByUsername">
      <![CDATA[ from User where username = :username ]]>
   </query>
   
   <query name="findUserByEmail">
      <![CDATA[ from User where email = :email ]]>
   </query>
      
</hibernate-mapping>

