<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="com.learn.persistence.bean" default-lazy="true" default-cascade="all-delete-orphan">
   <class name="AccessRecord" table="Access_Records" >
      <id name="id" type="long" column="id">
         <generator class="native">
            <param name="sequence">AccessRecord_Id_Seq</param>
         </generator>
      </id>
      
      <property name="remoteAddress" length="20" not-null="true" />
      
      <property name="dateCreated" type="java.util.Date" not-null="true" />

      <property name="symbol" length="10" not-null="true" />
   </class>
   
   <query name="getRecentAccessCount">
      <![CDATA[ select count(*) from AccessRecord where remoteAddress = :remoteAddress and dateCreated >= :date ]]>
   </query>
</hibernate-mapping>

