<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="com.learn.persistence.bean" default-lazy="true" default-cascade="all-delete-orphan">
   <class name="AccessHotList" table="Access_HotList_List">
      <id name="id" type="long" column="id">
         <generator class="native">
            <param name="sequence">AccessHotList_Id_Seq</param>
         </generator>
      </id>

      <property name="symbol" unique="true" length="10" not-null="true" />

      <property name="dateUpdated" type="java.util.Date" not-null="true" />

      <property name="accessCounter" />
   </class>

   <query name="findAccessHotListBySymbol">
      <![CDATA[ from AccessHotList where symbol = :symbol ]]>
   </query>

   <query name="retrieveAccessHotList">
      <![CDATA[ from AccessHotList order by dateUpdated desc, accessCounter desc ]]>
   </query>
</hibernate-mapping>

