<?xml version='1.0' encoding='utf-8'?>
<!DOCTYPE hibernate-configuration PUBLIC
"-//Hibernate/Hibernate Configuration DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
   <session-factory>

<!-- 
      <property name="connection.driver_class">com.mysql.jdbc.Driver</property>
      <property name="connection.url">jdbc:mysql://localhost:3306/test</property>
      <property name="connection.username">root</property>
      <property name="connection.password"></property>
 -->      
      <property name="dialect">org.hibernate.dialect.MySQL5InnoDBDialect</property>

 
<!-- 
      <property name="connection.driver_class">oracle.jdbc.driver.OracleDriver</property>
      <property name="connection.password">luke</property>
      <property name="connection.url">jdbc:oracle:thin:@localhost:1521:</property>
      <property name="connection.username">luke</property>
      <property name="default_catalog">luke</property>
      <property name="dialect">org.hibernate.dialect.Oracle10gDialect</property>
 -->
      <property name="connection.autocommit">false</property>
      <property name="connection.pool_size">35</property>
      <property name="jdbc.fetch_size">60</property>
      <property name="jdbc.use_scrollable_resultset">true</property>
      <property name="current_session_context_class">thread</property>
      <property name="cache.provider_class">org.hibernate.cache.NoCacheProvider</property>
      <property name="show_sql">true</property>
      <property name="format_sql">true</property>
      <property name="use_sql_comments">true</property>

<!-- Options for 'hbm2ddl.auto': validate, create-drop, create, update, drop, none. -->
      <property name="hbm2ddl.auto.444">create-drop</property>
      <property name="hbm2ddl.auto.222">create</property>
      <property name="hbm2ddl.auto">none</property>

      <mapping resource="com/learn/persistence/bean/User.hbm.xml" />
      <mapping resource="com/learn/persistence/bean/AccessRecord.hbm.xml" />
      <mapping resource="com/learn/persistence/bean/AccessAlarm.hbm.xml" />
      <mapping resource="com/learn/persistence/bean/AccessBlocked.hbm.xml" />
      <mapping resource="com/learn/persistence/bean/AccessHotList.hbm.xml" />          
   </session-factory>
</hibernate-configuration>

