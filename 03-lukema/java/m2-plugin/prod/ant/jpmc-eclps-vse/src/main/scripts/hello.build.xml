<project>
   <basename property="module" file="${basedir}" />

   <property name="workspace" value="/workspace/${module}" />

   <target name="init">
      <available file="${workspace}" type="dir" property="workspace.present">
      </available>
   </target>

   <target name="cin" depends="init" if="workspace.present">
      <copy todir="${workspace}/src" verbose="true">
         <fileset dir="src/main/java">
            <include name="**/*.java" />

            <exclude name="**/tmp/**" />

            <exclude name="**/fix/**" />
         </fileset>
      </copy>

      <copy todir="${workspace}/config" failonerror="false" verbose="true">
         <fileset dir="src/test/resources">
            <include name="**/*.properties" />

            <include name="**/*.xml" />

            <include name="**/*.xsl" />

            <include name="**/*.xsd" />

            <include name="**/*.clp" />

            <include name="**/*.gif" />

            <include name="**/*.jpg" />

            <exclude name="**/tmp/**" />

            <exclude name="**/fix/**" />
         </fileset>
      </copy>

      <copy todir="${workspace}/config" failonerror="false" verbose="true">
         <fileset dir="src/main/resources">
            <include name="**/*.properties" />

            <include name="**/*.xml" />

            <include name="**/*.xsd" />

            <include name="**/*.xsl" />

            <include name="**/*.clp" />

            <include name="**/*.gif" />

            <include name="**/*.jpg" />

            <exclude name="**/tmp/**" />

            <exclude name="**/fix/**" />
         </fileset>
      </copy>

      <copy todir="${workspace}/web" failonerror="false" verbose="true">
         <fileset dir="src/main/webapp">
            <include name="**/*.jsp" />

            <include name="**/*.xml" />

            <include name="**/*.jar" />

            <include name="**/*.css" />

            <include name="**/*.xsl" />

            <include name="**/*.xsd" />

            <exclude name="**/tmp/**" />

            <exclude name="**/fix/**" />
         </fileset>
      </copy>

      <copy todir="${workspace}" failonerror="false" verbose="true">
         <fileset dir="${basedir}">
            <include name="**/*.sh" />

            <include name="**/*.bat" />

            <exclude name="**/tmp/**" />

            <exclude name="**/fix/**" />
         </fileset>
      </copy>

      <copy todir="${workspace}" failonerror="false" verbose="true">
         <fileset dir="src/main">
            <include name="castor/**/*.xsd" />

            <include name="castor/**/*.properties" />

            <exclude name="**/tmp/**" />

            <exclude name="**/fix/**" />
         </fileset>
      </copy>

      <mkdir dir="${workspace}/logs" />

      <delete includeemptydirs="true">
         <fileset dir="${workspace}/logs" includes="**/*.txt" />
      </delete>
   </target>

   <target name="co" depends="init" if="workspace.present">
      <copy todir="src/main/java" verbose="true">
         <fileset dir="${workspace}/src">
            <include name="**/*.*" />
         </fileset>
      </copy>

      <copy todir="src/main/webapp" verbose="true">
         <fileset dir="${workspace}/web">
            <include name="**/*.*" />
         </fileset>
      </copy>
   </target>
</project>

