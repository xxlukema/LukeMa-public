<!-- 
      <property name="connection.driver_class">oracle.jdbc.driver.OracleDriver</property>
      <property name="connection.password">luke</property>
      <property name="connection.url">jdbc:oracle:thin:@localhost:1521:</property>
      <property name="connection.username">luke</property>
      <property name="default_catalog">luke</property>

      <property name="dialect">org.hibernate.dialect.Oracle10gDialect</property>
 -->

      <property name="dialect">org.hibernate.dialect.Oracle10gDialect</property>
      
      <property name="connection.autocommit">false</property>
      <property name="connection.pool_size">35</property>
      <property name="jdbc.fetch_size">60</property>
      <property name="jdbc.use_scrollable_resultset">true</property>
      <property name="current_session_context_class.tmp.delete">thread</property>
      <property name="cache.provider_class">org.hibernate.cache.NoCacheProvider</property>
      <property name="show_sql">true</property>
      <property name="format_sql">true</property>
      <property name="use_sql_comments">true</property>

<!-- Options for 'hbm2ddl.auto': validate, create-drop, create, update, drop, none. -->
      <property name="hbm2ddl.auto.333">create-drop</property>
      <property name="hbm2ddl.auto.222">create</property>
      <property name="hbm2ddl.auto.111">validate</property>
      
      <mapping class="com.learn.persistence.bean.User" />
	  <mapping class="com.learn.persistence.bean.AccessRecord" />
	  <mapping class="com.learn.persistence.bean.AccessAlarm" />
	  <mapping class="com.learn.persistence.bean.AccessBlocked" />
	  <mapping class="com.learn.persistence.bean.AccessHotList" />
		   
   </session-factory>
</hibernate-configuration>

