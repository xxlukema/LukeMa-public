{
  "java.configuration.updateBuildConfiguration": "automatic",
  "java.format.settings.url": ".vscode/eclipse-java-formatter-z-latest.xml",
  "java.format.comments.enabled": false,
  "java.format.enabled": true,
  "maven.view": "flat",
  "editor.minimap.enabled": false,
  "editor.tabSize": 2,
  "editor.rename.enablePreview": false,
  "workbench.editor.enablePreview": false,
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    ".angular/cache": true
  },
  "workbench.preferredHighContrastLightColorTheme": "Default High Contrast",
  "java.compile.nullAnalysis.mode": "automatic",
  "java.jdt.ls.lombokSupport.enabled": true,
  "boot-java.live-information.automatic-connection.on": false,
  "editor.guides.indentation": false,
  "python.analysis.extraPaths": [
    "./src/py"
  ],
  "[python]": {
    "editor.defaultFormatter": "ms-python.autopep8"
  },
  "java.debug.settings.onBuildFailureProceed": true,
  "java.jdt.ls.vmargs": "-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -Dsun.zip.disableMemoryMapping=true -Xmx2G -Xms100m"
}
