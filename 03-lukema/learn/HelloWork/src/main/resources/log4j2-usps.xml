<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE xml>
<Configuration status="WARN" monitorInterval="30" strict="true"
	includeLocation="true">
	<Properties>
	    <Property name="log-dir">${env:TOMCAT_HOME}/logs</Property>
		<Property name="log-prefix">eems</Property>
		<Property name="log-suffix">log</Property>
	</Properties>
	<Appenders>
		<Console name="CONSOLE" target="SYSTEM_OUT">
			<PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %-5p %c(%L) %M() %n%m%n" />
		</Console>
		<RollingFile name="RollingFile" fileName="${log-dir}/${log-prefix}.${log-suffix}"
			filePattern="${log-dir}/${log-prefix}-%d{yyyy-MM-dd}-%i.${log-suffix}">
			<PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %-5p %c(%L) %M() %n%m%n" />
			<Policies>
			    <TimeBasedTriggeringPolicy />
				<SizeBasedTriggeringPolicy size="15 MB" />
			</Policies>
			<DefaultRolloverStrategy max="20000" />
		</RollingFile>
		<Async name="ASYNC">
			<AppenderRef ref="CONSOLE" />
			<AppenderRef ref="RollingFile" />
		</Async>
	</Appenders>
	<Loggers>
		<Logger name="gov" level="debug" additivity="false">
			<AppenderRef ref="CONSOLE" />
			<AppenderRef ref="RollingFile" />
		</Logger>
		<Logger name="com" level="info" additivity="false">
			<AppenderRef ref="CONSOLE" />
			<AppenderRef ref="RollingFile" />
		</Logger>
		<Logger name="com.mchange" level="info" additivity="false">
			<AppenderRef ref="CONSOLE" />
			<AppenderRef ref="RollingFile" />
		</Logger>

		<Root level="error">
			<AppenderRef ref="ASYNC" />
		</Root>
	</Loggers>
</Configuration>
