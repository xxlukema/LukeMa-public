{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "device": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "description": "Name of event",
          "type": "string",
          "minLength": 8,
          "maxLength": 20
        },
        "ip": {
          "type": "string",
          "format": "ipv4"
        },
        "category": {
          "description": "Organization",
          "type": "string",
          "minLength": 8,
          "maxLength": 20
        },
        "class": {
          "description": "Class of device",
          "type": "string",
          "minLength": 8,
          "maxLength": 20
        },
        "organization": {
          "description": "Organization",
          "enum": [
            "Air Force",
            "Army",
            "Joint",
            "PATS",
            "System"
          ]
        },
        "health": {
          "description": "Health state of device",
          "enum": [
            "Critical",
            "Major",
            "Minor",
            "Notice",
            "Healthy"
          ]
        },
        "collectionState": {
          "description": "Collection Status",
          "enum": [
            "active",
            "unavailable",
            "user-disabled/unavailable"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "ip",
        "category",
        "class",
        "organization",
        "health",
        "collectionState"
      ]
    }
  },
  "required": [
    "device"
  ]
}
