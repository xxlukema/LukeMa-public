{
  "$schema": "https://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "event": {
      "type": "object",
      "properties": {
        "organization": {
          "description": "Organization",
          "type": "string",
          "minLength": 4,
          "maxLength": 255
        },
        "deviceName": {
          "description": "Name of device",
          "type": "string",
          "minLength": 8,
          "maxLength": 255
        },
        "severity": {
          "description": "Severity of event",
          "enum": [
            "Critical",
            "Major",
            "Minor",
            "Notice",
            "Healthy"
          ]
        },
        "name": {
          "description": "Name of event",
          "type": "string",
          "minLength": 8,
          "maxLength": 255
        },
        "message": {
          "description": "Event message",
          "type": "string",
          "minLength": 8,
          "maxLength": 255
        },
        "lastDetectedUtc": {
          "description": "Last detected datetime UTC",
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "organization",
        "deviceName",
        "severity",
        "name",
        "message",
        "lastDetectedUtc"
      ]
    }
  },
  "required": [
    "event"
  ]
}
