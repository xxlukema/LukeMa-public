<?xml version="1.0" encoding="UTF-8"?>
<configuration debug="true">

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
      <pattern>
        ### %d{yyyy-MM-dd HH:mm:ss} [%-5p] %c\(%L\) %M\(\) %n%m%n
      </pattern>
    </encoder>
  </appender>

  <logger name="com" level="debug" additivity="false">
    <appender-ref ref="CONSOLE" />
  </logger>
  <!-- com.zaxxer is for HikariCP (Hikari Connection Pool)
  (https://www.baeldung.com/spring-boot-hikari) -->
  <!-- In Spring Boot 1, Tomcat JDBC Connection Pool is the default DataSource implementation -->
  <!-- In Spring Boot 2, Hikari is the default DataSource implementation -->
  <logger name="com.zaxxer" level="warn" additivity="false">
    <appender-ref ref="CONSOLE" />
  </logger>
  <!-- com.ulisesbocchio is for Jasypt Spring Boot Encryption -->
  <logger name="com.ulisesbocchio" level="warn" additivity="false">
    <appender-ref ref="CONSOLE" />
  </logger>
  <!-- spring -->
  <logger name="org.springframework" level="debug" additivity="false">
    <appender-ref ref="CONSOLE" />
  </logger>
  <logger name="org.springframework.boot.web" level="debug" additivity="false">
    <appender-ref ref="CONSOLE" />
  </logger>
  <logger name="org.springframework.jdbc.core" level="trace" additivity="false">
    <appender-ref ref="CONSOLE" />
  </logger>

  <root name="ecorrRoot" level="DEBUG">
  </root>

</configuration>
