  <profiles>
    <!-- https://www.baeldung.com/maven-profiles -->
    <!-- default file -->
    <!-- mvn help:active-profiles -Denv=dev -->
    <profile>
      <id>laptop</id>
      <activation>
        <activeByDefault>true</activeByDefault>
        <os>
          <!-- active on Windows -->
          <family>Windows</family>
        </os>
      </activation>
      <properties>
        <filter.file.suffix>laptop</filter.file.suffix>
      </properties>
    </profile>

    <!-- mvn -P fluentd clean package -->
    <!-- mvn help:active-profiles -Denv=dev -P fluentd -->
    <profile>
      <id>linux</id>
      <activation>
        <os>
          <!-- active on Linux -->
          <family>Linux</family>
        </os>
      </activation>
      <properties>
        <filter.file.suffix>linux</filter.file.suffix>
      </properties>
    </profile>
  </profiles>

