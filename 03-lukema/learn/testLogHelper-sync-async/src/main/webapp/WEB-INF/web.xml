<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE web-app
PUBLIC "-//Sun Microsystems, Inc.//DTD Web Application 2.2//EN"
"http://java.sun.com/j2ee/dtds/web-app_2_2.dtd">
<web-app>
   <display-name>WS-SERVLET WebService</display-name>

   <servlet>
      <servlet-name>hello</servlet-name>

      <servlet-class>com.learn.webservice.HelloWorldServlet</servlet-class>
   </servlet>

   <servlet>
      <servlet-name>soap</servlet-name>

      <servlet-class>com.learn.webservice.SOAPEchoServiceServlet</servlet-class>
   </servlet>

   <servlet-mapping>
      <servlet-name>hello</servlet-name>

      <url-pattern>/HelloWorld</url-pattern>
   </servlet-mapping>

   <servlet-mapping>
      <servlet-name>soap</servlet-name>

      <url-pattern>/EchoService</url-pattern>
   </servlet-mapping>

<!-- The Usual Welcome File List -->
   <welcome-file-list>
      <welcome-file>index.jsp</welcome-file>
   </welcome-file-list>
</web-app>

