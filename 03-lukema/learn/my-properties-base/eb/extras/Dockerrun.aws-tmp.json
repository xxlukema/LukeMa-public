{
    "AWSEBDockerrunVersion": "3",
    "authentication": {
        "bucket": "lukema-s3-bucket",
        "key": "config.json"
    },
    "containerDefinitions": [
        {
            "name": "my-rpoperties-base",
            "image": "my-rpoperties-base:1.0",
            "environment": [
                {
                    "name": "Container",
                    "value": "my-rpoperties-base"
                }
            ],
            "portMappings": [
                {
                    "hostPort": 80,
                    "containerPort": 8080
                }
            ],
            "mountPoints": [
                {
                    "sourceVolume": "/home/ec2-user/tomcat-logs",
                    "containerPath": "/usr/local/tomcat/logs",
                    "readOnly": false
                }
            ]
        }
    ]
}