      <property name="driverClassName">
         <value>net.sourceforge.jtds.jdbc.Driver</value>
      </property>
       
      <property name="url">
         <value>jdbc:jtds:sybase://esssybd1.uk.db.com:5000;DatabaseName=ETS_ESS_TEST2</value>
      </property>

      <property name="username">
         <value>ess_batch</value>
      </property>

      <property name="password">
         <value>ess_batch01</value>
      </property>
   </bean> 

</beans>
