{
  "name": "hello-protractor",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "lint": "ng lint",
    "it": "npx cypress open",
    "itcy": "npx cypress run",
    "snippets": "node ./node_modules/cucumber/bin/cucumber-js cypress/integration/**/*.feature --dry-run --no-color --require step-definitions/**/*.ts --require hooks/**/*.ts --require-module ts-node/register",
    "snippets2": "node ./node_modules/cucumber/bin/cucumber-js cypress/integration/**/*.feature --dry-run --no-color --require step-definitions/**/*.ts --require hooks/**/*.ts --require-module ts-node/register --format snippets",
    "e2e": "ng e2e",
    "xit": "cd e2e && npx protractor ./protractor.conf.js",
    "xxit": "cd e2e && npx protractor --disableChecks ./protractor.conf.js",
    "xxit-deprecated-comment": "--webdriver-update=false deprecated. use --disableChecks",
    "xxit-deprecated": "npx protractor --webdriver-update=false ./protractor.conf.js",
    "xpostinstall-freddie": "npx webdriver-manager update --ignore_ssl --gecko false --standalone false",
    "xxpostinstall-freddie": "npx webdriver-manager update --ignore_ssl --gecko false --standalone false --chrome --versions.chrome 89.0.4389.82",
    "install_my_lib": "npm i --force @luke/my-conf-lib --registry http://localhost:4873/",
    "postinstall": "npx ngcc",
    "postinstall_my_lib": "npx ngcc"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~14.2.3",
    "@angular/cdk": "^14.2.2",
    "@angular/common": "~14.2.3",
    "@angular/compiler": "~14.2.3",
    "@angular/core": "~14.2.3",
    "@angular/flex-layout": "^14.0.0-beta.40",
    "@angular/forms": "^14.2.3",
    "@angular/material": "^14.2.2",
    "@angular/platform-browser": "~14.2.3",
    "@angular/platform-browser-dynamic": "~14.2.3",
    "@angular/router": "~14.2.3",
    "@fortawesome/fontawesome-free": "^6.2.0",
    "@luke/my-conf-lib": "^1.2.5",
    "@ngrx/store": "^14.3.1",
    "@popperjs/core": "^2.11.6",
    "bootstrap": "^5.2.1",
    "jquery": "^3.6.1",
    "material-design-icons": "^3.0.1",
    "ngx-mask": "^14.2.3",
    "ngx-webstorage": "^10.0.1",
    "rxjs": "~7.5.6",
    "tslib": "^2.4.0",
    "zone.js": "~0.11.8"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^14.2.3",
    "@angular/cli": "~14.2.3",
    "@angular/compiler-cli": "~14.2.3",
    "@badeball/cypress-cucumber-preprocessor": "^13.0.1",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.1.4",
    "@cucumber/cucumber": "^8.6.0",
    "@cypress/browserify-preprocessor": "^3.0.2",
    "@esbuild-plugins/node-modules-polyfill": "^0.1.4",
    "@serenity-js/cucumber": "^3.0.0-rc.27",
    "@types/chai": "^4.3.3",
    "@types/chai-as-promised": "^7.1.5",
    "@types/jasmine": "^4.3.0",
    "@types/node": "^18.7.18",
    "@typescript-eslint/eslint-plugin": "^5.38.0",
    "@typescript-eslint/parser": "^5.38.0",
    "chai": "^4.3.6",
    "chai-as-promised": "^7.1.1",
    "codelyzer": "^6.0.2",
    "cucumber-html-reporter": "^5.5.0",
    "cypress": "^10.8.0",
    "eslint": "^8.23.1",
    "jasmine-core": "^4.4.0",
    "jasmine-marbles": "^0.9.2",
    "jasmine-spec-reporter": "^7.0.0",
    "karma": "^6.4.1",
    "karma-chrome-launcher": "^3.1.1",
    "karma-coverage": "^2.2.0",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.0.0",
    "protractor": "~7.0.0",
    "protractor-cucumber-framework": "^8.4.4",
    "protractor-multiple-cucumber-html-reporter-plugin": "^1.8.1",
    "protractor-simple-cucumber-html-reporter-plugin": "^1.0.4",
    "serenity-js": "^1.10.14",
    "ts-node": "~10.9.1",
    "typescript": "^4.8.3"
  },
  "cypress-cucumber-preprocessor": {
    "stepDefinitions": "cypress/integration/saucedemo/**/*.cy.ts",
    "cucumberJson": {
      "generate": true,
      "outputFolder": "cypress/cucumber-json",
      "filePrefix": "",
      "fileSuffix": ".cucumber"
    }
  }
}
