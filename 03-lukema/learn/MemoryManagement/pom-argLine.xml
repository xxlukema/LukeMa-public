<project xmlns="https://maven.apache.org/POM/4.0.0" xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">


   <build>
   </build>

   <reporting>
      <plugins>
         <plugin>
            <groupId>org.apache.maven.plugins</groupId>

            <artifactId>maven-surefire-report-plugin</artifactId>

            <version>2.5</version>
         </plugin>

         <plugin>
            <groupId>org.apache.maven.plugins</groupId>

            <artifactId>maven-surefire-plugin</artifactId>

            <configuration>
               <argLine>-Xms128m -Xmx1024m -XX:MaxPermSize=256m</argLine>

               <argLine>-XX:+PrintCommandLineFlags -XX:+PrintCompilation -XX:+PrintGCDetails -XX:+PrintGCTimeStamps -XX:+UseParallelGC</argLine>

               <argLine>-XX:MaxHeapSize=512m</argLine>

               <argLine>-Xms128m -Xmx1024m -XX:MaxPermSize=256m</argLine>

               <argLine>-Xms128m -Xmx1024m -XX:MaxPermSize=256m</argLine>

               <argLine>-Xms128m -Xmx1024m -XX:MaxPermSize=256m</argLine>

               <argLine>-Xms128m -Xmx1024m -XX:MaxPermSize=256m</argLine>

               <argLine>-Xms128m -Xmx1024m -XX:MaxPermSize=256m</argLine>

               <argLine>-Xms128m -Xmx1024m -XX:MaxPermSize=256m</argLine>

               <disableXmlReport>true</disableXmlReport>
            </configuration>
         </plugin>
      </plugins>
   </reporting>
</project>
