<?xml version='1.0' encoding='utf-8'?>
<!DOCTYPE hibernate-configuration PUBLIC
"-//Hibernate/Hibernate Configuration DTD 3.0//EN"
"http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
	<session-factory>

		<property name="hibernate.dialect">org.hibernate.dialect.Oracle10gDialect</property>

		<property name="hibernate.connection.autocommit">false</property>
		<property name="connection.pool_size">10</property>
		<property name="jdbc.fetch_size">10</property>
		<property name="jdbc.use_scrollable_resultset">true</property>
		<property name="cache.provider_class">org.hibernate.cache.NoCacheProvider</property>
		<property name="show_sql">false</property>
		<property name="format_sql">true</property>
        <property name="use_sql_comments">true</property>

		<!-- Options for 'hbm2ddl.auto': validate, create-drop, create, update, 
			drop, none. -->
		<property name="hbm2ddl.auto.1">create-drop</property>
		<property name="hbm2ddl.auto.2">create</property>
		<property name="hbm2ddl.auto">none</property>

		<mapping class="com.learn.bean.Customer" />
		<mapping class="com.learn.bean.Portfolio" />
		<mapping class="com.learn.bean.PortfolioItem" />

	</session-factory>
</hibernate-configuration>

