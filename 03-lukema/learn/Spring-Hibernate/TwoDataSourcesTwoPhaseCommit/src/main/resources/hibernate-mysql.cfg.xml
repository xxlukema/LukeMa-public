<?xml version='1.0' encoding='utf-8'?>
<!DOCTYPE hibernate-configuration PUBLIC
"-//Hibernate/Hibernate Configuration DTD 3.0//EN"
"http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
	<session-factory>

		<!-- InnoDB support transaction. MySQLDialect does not support transaction. -->

		<property name="hibernate.dialect">org.hibernate.dialect.MySQL5InnoDBDialect</property>

		<!-- -->
		<property name="hibernate.connection.autocommit">false</property>
		<property name="connection.pool_size">10</property>
		<property name="jdbc.fetch_size">10</property>
		<property name="jdbc.use_scrollable_resultset">true</property>
		<property name="cache.provider_class">org.hibernate.cache.NoCacheProvider</property>
		<property name="show_sql">true</property>

		<!-- Options for 'hbm2ddl.auto': validate, create-drop, create, update, 
			drop, none. -->
		<property name="hbm2ddl.auto.0">create-drop</property>
		<property name="hbm2ddl.auto">create</property>
		<property name="hbm2ddl.auto.1">none</property>

		<mapping class="com.learn.bean.mysql.Widget" />

	</session-factory>
</hibernate-configuration>

