package momentum;

import javax.swing.*;
import java.awt.*;
import java.util.*;

import common.*;

public class MomentumLineFrame extends JFrame
{
   public  static final int WIDTH  = 980;
   public  static final int HEIGHT = 600;
   public  static final int EDGE   = 20;

   public  static final int Y0 = (int)(HEIGHT/2+EDGE);
   public  static final int X0 = (int)(EDGE);

   private static int   [] X = null;

   private static final Vector RAW_Y      = new Vector();
   private static final Vector ADJUSTED_Y = new Vector();

   private static final MomentumLineFrame FRAME = new MomentumLineFrame();

   private static int MAX = -9999999;
   private static int MIN =  9999999;

   private static float [] tomorrowHighTarget    = null;
   private static float [] tomorrowLowTarget     = null;
   private static int   [] tomorrowHighTargetInt = null;
   private static int   [] tomorrowLowTargetInt  = null;
   private static float [] tomorrowHighStop      = null;
   private static float [] tomorrowLowStop       = null;
   private static int   [] tomorrowHighStopInt   = null;
   private static int   [] tomorrowLowStopInt    = null;

   private static boolean isAdjusted = false;

   private int xtomorrow = WIDTH+EDGE;

   private static String summary = null;

   static 
   {
      FRAME.setDefaultCloseOperation(EXIT_ON_CLOSE);
      FRAME.setSize(WIDTH+2*EDGE, HEIGHT+2*EDGE);
   }

   public static void setSummary(String sum)
   {
      summary = sum;
   }

   public static void newTitle(String title)
   {
      FRAME.setTitle(title);
   }

   public static void addPredict(float [] predictedHighTarget, 
                                 float [] predictedLowTarget,
                                 float [] predictedHighStop,
                                 float [] predictedLowStop)
   {
      tomorrowHighTarget   = predictedHighTarget;
      tomorrowLowTarget    = predictedLowTarget;
      tomorrowHighStop     = predictedHighStop;
      tomorrowLowStop      = predictedLowStop;
   }

   public static void addX(float [] xx)
   {
      if(xx == null || xx.length == 0)
      {
         System.out.println("****** \"float [] x\" is null or empty.");
      }
      else
      {
         float minX = MIN;
         float maxX = MAX;

         for(int i=0; i<xx.length; i++)
         {
            minX = Math.min(xx[i], minX);
            maxX = Math.max(xx[i], maxX);
         }

         float fx = (float) (WIDTH/(maxX-minX+1));

         X = new int [xx.length];

         for(int i=0; i<xx.length; i++)
         {
            X[i] = (int) (X0 + (xx[i]-minX) * fx);
         }
      }
   }

   public static void addY(float [] yy)
   {
      if(yy != null && yy.length == X.length)
      {
         RAW_Y.add(yy);
      }
      else
      {
         System.out.println("****** \"float [] y\" is null or size does not match with x.");
      }
   }

   public void drawGrid(Graphics g)
   {
      // draw grids
      g.setColor(Color.CYAN);
      Stroke s = new BasicStroke(3);
      ((Graphics2D) g).setStroke(s);
      for (int i=X.length-1; i>=0; i -= Setting.HALF_CYCLE)
      {
         g.drawLine(X[i], EDGE, X[i], HEIGHT+EDGE);
      }

      s = new BasicStroke(1);
      ((Graphics2D) g).setStroke(s);
      for(int i=0; i<X.length; i++)
      {
         g.drawLine(X[i], EDGE, X[i], HEIGHT+EDGE);
      }

      g.drawLine(xtomorrow, EDGE, xtomorrow, HEIGHT+EDGE);

      g.drawLine(X0, Y0, WIDTH+EDGE, Y0);
   }

   public void drawTomorrow(Graphics g)
   {
      if(tomorrowHighTargetInt != null)
      {
         Color c = Color.YELLOW;
         g.setColor(c);
         Stroke s = new BasicStroke(3);
         ((Graphics2D) g).setStroke(s);
         g.drawLine(X[X.length-1], tomorrowHighTargetInt[0], xtomorrow, tomorrowHighTargetInt[1]);
         g.drawLine(X[X.length-1], tomorrowLowTargetInt[0] , xtomorrow, tomorrowLowTargetInt[1]);

         c = Color.MAGENTA;
         g.setColor(c);
         s = new BasicStroke(1);
         ((Graphics2D) g).setStroke(s);
         g.drawLine(X[X.length-1], tomorrowHighTargetInt[0], xtomorrow, tomorrowHighTargetInt[1]);
         g.drawLine(X[X.length-1], tomorrowLowTargetInt[0] , xtomorrow, tomorrowLowTargetInt[1]);
         g.drawLine(X[X.length-1], tomorrowHighStopInt[0], xtomorrow, tomorrowHighStopInt[1]);
         g.drawLine(X[X.length-1], tomorrowLowStopInt[0] , xtomorrow, tomorrowLowStopInt[1]);
      }
   }

   public void drawSummary(Graphics g)
   {
      if(summary != null)
      {
         g.setColor(Color.black);
         g.setFont(new Font("Courier New", Font.BOLD, 12));
         String [] lines = summary.split("\n");
         for(int i=0; i<lines.length; i++)
         {
            g.drawString(lines[i], WIDTH/10, EDGE+16*(i+11));
         }
      }
   }

   public void paint(Graphics g)
   {
      adjustY();

      drawGrid(g);

      drawTBP(g);
      drawTarget(g);
      drawStop(g);

      drawOHLC(g);

      drawSummary(g);
   }

   public void drawTBP(Graphics g)
   {
      Color c = Color.WHITE;

      int [] highTBP  = (int []) ADJUSTED_Y.get(4);
      int [] lowTBP   = (int []) ADJUSTED_Y.get(5);

      drawLine(g, highTBP, c, 2);
      drawLine(g, lowTBP,  c, 2);
   }

   public void drawTarget(Graphics g)
   {
      int [] highTarget  = (int []) ADJUSTED_Y.get(6);
      int [] lowTarget   = (int []) ADJUSTED_Y.get(7);

      Color c = Color.YELLOW;
      drawLine(g, highTarget, c, 3);
      drawLine(g, lowTarget,  c, 3);

      c = Color.MAGENTA;
      drawLine(g, highTarget, c, 1);
      drawLine(g, lowTarget,  c, 1);

      drawTomorrow(g);
   }

   public void drawStop(Graphics g)
   {
      int [] highStop  = (int []) ADJUSTED_Y.get(8);
      int [] lowStop   = (int []) ADJUSTED_Y.get(9);

      Color c = Color.MAGENTA;
      drawLine(g, highStop, c, 1);
      drawLine(g, lowStop,  c, 1);
   }

   public static void adjustY()
   {
      if (isAdjusted)
      {
         return;
      }

      isAdjusted = true;

      float minY = MIN;
      float maxY = MAX;

      for(int v=0; v<RAW_Y.size(); v++)
      {
         float [] yy = (float []) RAW_Y.get(v);

         for(int i=0; i<yy.length; i++)
         {
            maxY = Math.max(yy[i], maxY);
            minY = Math.min(yy[i], minY);
         }
      }

      if(tomorrowHighTarget != null && tomorrowLowTarget != null)
      {
         for(int i=0; i<tomorrowHighTarget.length; i++)
         {
            maxY = Math.max(tomorrowHighTarget[i], maxY);
            minY = Math.min(tomorrowLowTarget[i],  minY);

            maxY = Math.max(tomorrowHighStop[i], maxY);
            minY = Math.min(tomorrowLowStop[i],  minY);
         }
      }

      float fy = (float) (HEIGHT/(maxY-minY)/1.05);

      ADJUSTED_Y.clear();
      for(int v=0; v<RAW_Y.size(); v++)
      {
         float [] yy = (float []) RAW_Y.get(v);

         int [] y = new int [yy.length];
         for(int i=0; i<yy.length; i++)
         {
            y[i] = (int) (HEIGHT + EDGE - (yy[i]-minY) * fy);
         }

         ADJUSTED_Y.add(y);
      }

      if(tomorrowHighTarget != null)
      {
         tomorrowHighTargetInt = new int [2];
         tomorrowLowTargetInt  = new int [2];

         tomorrowHighTargetInt[0] = (int) (HEIGHT + EDGE - (tomorrowHighTarget[0]-minY) * fy);
         tomorrowHighTargetInt[1] = (int) (HEIGHT + EDGE - (tomorrowHighTarget[1]-minY) * fy);
         tomorrowLowTargetInt[0]  = (int) (HEIGHT + EDGE - (tomorrowLowTarget[0] -minY) * fy);
         tomorrowLowTargetInt[1]  = (int) (HEIGHT + EDGE - (tomorrowLowTarget[1] -minY) * fy);

         tomorrowHighStopInt = new int [2];
         tomorrowLowStopInt  = new int [2];

         tomorrowHighStopInt[0] = (int) (HEIGHT + EDGE - (tomorrowHighStop[0]-minY) * fy);
         tomorrowHighStopInt[1] = (int) (HEIGHT + EDGE - (tomorrowHighStop[1]-minY) * fy);
         tomorrowLowStopInt[0]  = (int) (HEIGHT + EDGE - (tomorrowLowStop[0] -minY) * fy);
         tomorrowLowStopInt[1]  = (int) (HEIGHT + EDGE - (tomorrowLowStop[1] -minY) * fy);
      }
   }

   public static void draw()
   {
      FRAME.show();
   }

   private void drawOHLC(Graphics g)
   {
      int [] open  = (int []) ADJUSTED_Y.get(0);
      int [] high  = (int []) ADJUSTED_Y.get(1);
      int [] low   = (int []) ADJUSTED_Y.get(2);
      int [] close = (int []) ADJUSTED_Y.get(3);

      Stroke s = new BasicStroke(3);

      for(int i=0; i<open.length; i++)
      {
         Color c = null;

         // these open/close are after adjustment for drawing. 
         // if open > close, the actual values before adjust 
         // for draw is open < close.
         if (open[i] > close[i])
         {
            c = Color.BLUE;
         }
         else
         {
            c = Color.RED;
         }

         g.setColor(c);

         ((Graphics2D) g).setStroke(s);

         g.drawLine(X[i],   low[i],   X[i], high[i]);
         g.drawLine(X[i]-4, open[i],  X[i], open[i]);
         g.drawLine(X[i]+4, close[i], X[i], close[i]);
      }
   }

   public void drawLine(Graphics g, int [] y, Color c)
   {
      drawLine(g, y, c, 1);
   }

   public void drawLine(Graphics g, int [] y, Color c, int lineWidth)
   {
      Stroke s = new BasicStroke(lineWidth);
      ((Graphics2D) g).setStroke(s);
      if(c == null)
      {
         c = Color.BLACK;
      }
      g.setColor(c);

      g.drawPolyline(X, y, X.length);
   }

   public void drawLine(Graphics g, int [] y, int lineWidth)
   {
      Stroke s = new BasicStroke(lineWidth);
      ((Graphics2D) g).setStroke(s);

      g.drawPolyline(X, y, X.length);
   }
}

