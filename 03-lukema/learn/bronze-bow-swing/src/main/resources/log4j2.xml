<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE xml>
<Configuration status="WARN" monitorInterval="30" strict="true" includeLocation="true">
    <Appenders>
        <Console name="CONSOLE" target="SYSTEM_OUT">
            <PatternLayout>
                <Pattern>
                    #### %d{yyyy-MM-dd HH:mm:ss} [%-5p] %c(%L) %M() %n%m%n
                </Pattern>
            </PatternLayout>
        </Console>
        <Async name="ASYNC">
            <AppenderRef ref="CONSOLE" />
        </Async>
    </Appenders>

    <Loggers>

        <!-- app loggers -->
        <Logger name="com.learn" level="debug" additivity="false">
            <AppenderRef ref="CONSOLE" />
        </Logger>
        <Logger name="com.learn.filter" level="info" additivity="false">
            <AppenderRef ref="CONSOLE" />
        </Logger>
        <Logger name="com.learn.filter.BootRequestHeaderFilter2" level="debug" additivity="false">
            <AppenderRef ref="CONSOLE" />
        </Logger>

        <logger name="org.springframework" level="warn" additivity="false">
            <AppenderRef ref="CONSOLE" />
        </logger>
        <logger name="org.springframework.web" level="info" additivity="false">
            <AppenderRef ref="CONSOLE" />
        </logger>
        <!--
        <logger name="org.springframework.security.web" level="warn" additivity="false">
            <AppenderRef ref="CONSOLE" />
        </logger>
         -->
        <logger name="org.springframework.boot.web" level="info" additivity="false">
            <AppenderRef ref="CONSOLE" />
        </logger>
        <logger name="org.springframework.jdbc.core" level="trace" additivity="false">
            <AppenderRef ref="CONSOLE" />
        </logger>
        <logger name="org.hibernate" level="warn" additivity="false">
            <AppenderRef ref="CONSOLE" />
        </logger>
        <!-- Change org.hibernate.SQL level to debug to see SQL -->
        <logger name="org.hibernate.SQL" level="debug" additivity="false">
            <AppenderRef ref="CONSOLE" />
        </logger>
        <!-- Change org.hibernate.type level to trace to display SQL parameters -->
        <logger name="org.hibernate.type" level="trace" additivity="false">
            <AppenderRef ref="CONSOLE" />
        </logger>
        <logger name="org.hibernate.type.BasicTypeRegistry" level="warn" additivity="false">
            <AppenderRef ref="CONSOLE" />
        </logger>
        <logger name="org.hibernate.type.TypeFactory" level="warn" additivity="false">
            <AppenderRef ref="CONSOLE" />
        </logger>
        <logger name="org.hibernate.type.descriptor.sql.BasicExtractor" level="warn" additivity="false">
            <AppenderRef ref="CONSOLE" />
        </logger>

        <!-- undefined -->
        <Logger name="com" level="debug" additivity="false">
            <AppenderRef ref="CONSOLE" />
        </Logger>
        <Logger name="org" level="debug" additivity="false">
            <AppenderRef ref="CONSOLE" />
        </Logger>

        <!-- com.zaxxer is for HikariCP (Hikari Connection Pool) (https://www.baeldung.com/spring-boot-hikari) -->
        <!-- https://github.com/brettwooldridge/HikariCP#configuration-knobs-baby -->
        <!-- In Spring Boot 1, Tomcat JDBC Connection Pool is the default DataSource implementation -->
        <!-- In Spring Boot 2, Hikari is the default DataSource implementation -->
        <logger name="com.zaxxer" level="debug" additivity="false">
            <AppenderRef ref="CONSOLE" />
        </logger>
        <!-- tomcat pool -->
        <logger name="org.apache.catalina.session" level="debug" additivity="false">
            <AppenderRef ref="CONSOLE" />
        </logger>
        <!-- com.ulisesbocchio is for Jasypt Spring Boot Encryption -->
        <logger name="com.ulisesbocchio" level="warn" additivity="false">
            <AppenderRef ref="CONSOLE" />
        </logger>

        <!-- root -->
        <Root level="error">
            <AppenderRef ref="ASYNC" />
        </Root>
    </Loggers>
</Configuration>
