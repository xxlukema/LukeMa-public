{
  "name": "activedash-ws",
  "version": "2.11.2",
  "license": "MIT",
  "scripts": {
    "e2e": "ng e2e",
    "ng": "ng",
    "start": "ng serve",
    "it": "npx cypress open",
    "reports": "node cypress/cucumber-html-report.ts",
    "build": "ng build --configuration=production",
    "prebuild": "npm run updateBuild",
    "preupdateBuild": "npm run preupdateBuildCommon && npm run preupdateBuild5g && npm run preupdateBuildNms",
    "preupdateBuildCommon": "cp projects/common/src/environments/environment.ts projects/common/src/environments/environment.prod.ts",
    "preupdateBuild5g": "cp projects/5g/src/environments/environment.ts projects/5g/src/environments/environment.prod.ts",
    "preupdateBuildNms": "cp projects/nms/src/environments/environment.ts projects/nms/src/environments/environment.prod.ts",
    "updateBuild": "node ./replace.build.js",
    "postinstall": "ngcc",
    "lint": "npx eslint .",
    "lint_fix": "npx eslint . --fix",
    "test": "rm -rf cypress/reports && npx cypress run & npm run reports"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^16.2.7",
    "@angular/cdk": "^16.2.6",
    "@angular/common": "^16.2.7",
    "@angular/compiler": "^16.2.7",
    "@angular/core": "^16.2.7",
    "@angular/forms": "^16.2.7",
    "@angular/google-maps": "^16.2.6",
    "@angular/localize": "^16.2.7",
    "@angular/material": "^16.2.6",
    "@angular/material-moment-adapter": "^16.2.6",
    "@angular/platform-browser": "^16.2.7",
    "@angular/platform-browser-dynamic": "^16.2.7",
    "@angular/router": "^16.2.7",
    "@coreui/angular": "^4.5.16",
    "@coreui/coreui": "^4.3.2",
    "@coreui/coreui-plugin-chartjs-custom-tooltips": "^1.3.1",
    "@coreui/icons": "^3.0.1",
    "@coreui/icons-angular": "4.5.16",
    "@fortawesome/fontawesome-free": "^6.4.2",
    "@ng-bootstrap/ng-bootstrap": "^15.1.1",
    "@ng-idle/core": "^13.0.0",
    "@ng-idle/keepalive": "^13.0.0",
    "@ngrx/store": "^16.3.0",
    "angular-feather": "^6.5.0",
    "bootstrap": "^5.3.2",
    "buffer": "^6.0.3",
    "chart.js": "^4.4.0",
    "chartjs-plugin-datalabels": "^2.2.0",
    "compass-mixins": "^0.12.12",
    "flag-icon-css": "^3.5.0",
    "keycloak-angular": "^14.1.0",
    "keycloak-js": "^22.0.3",
    "material-design-icons": "^3.0.1",
    "ng2-charts": "^5.0.3",
    "ng2-tooltip-directive": "^2.10.3",
    "ngx-bootstrap": "^11.0.2",
    "ngx-filesaver": "^16.0.0",
    "ngx-mask": "^16.3.9",
    "ngx-perfect-scrollbar": "^10.1.1",
    "rxjs": "^7.8.1",
    "simple-line-icons": "^2.5.5",
    "ts-helpers": "^1.1.2",
    "tslib": "^2.6.2",
    "web-animations-js": "^2.3.2",
    "zone.js": "~0.14.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^16.2.4",
    "@angular/cli": "^16.2.4",
    "@angular/compiler-cli": "^16.2.7",
    "@angular/language-service": "^16.2.7",
    "@types/estree": "^1.0.2",
    "@types/file-saver": "^2.0.5",
    "@types/jasmine": "^4.3.6",
    "@types/jasminewd2": "^2.0.11",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "@typescript-eslint/parser": "^6.7.4",
    "codelyzer": "^6.0.2",
    "cypress": "^13.3.0",
    "cypress-cucumber-preprocessor": "^4.3.1",
    "eslint": "^8.50.0",
    "jasmine-core": "~5.1.1",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "~6.4.2",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "multiple-cucumber-html-reporter": "^3.5.0",
    "ng-packagr": "^16.2.3",
    "replace-in-file": "^7.0.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  },
  "browser": {
    "child_process": false
  },
  "cypress-cucumber-preprocessor": {
    "nonGlobalStepDefinitions": true,
    "cucumberJson": {
      "generate": true,
      "outputFolder": "cypress/reports/cucumber-json",
      "filePrefix": "",
      "fileSuffix": ".cucumber"
    }
  },
  "bundleDependencies": [
    "@nms/common",
    "@nms/core"
  ]
}
