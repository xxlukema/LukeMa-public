    "src/app/shared/breadcrumb/breadcrumb.component.ts",
    "src/app/shared/user/user.action.ts",
    "src/app/shared/user/user.reducer.ts",
    "src/app/shared/user/user.selector.ts",
    "src/app/shared/user/user.state.ts",
    "src/app/shared/user/user.type.ts",
    "src/app/utils/guard/nms.guard.ts",
    "src/app/utils/loading/loading.component.ts",
    "src/app/utils/loading/loading.module.ts",
    "src/app/utils/progress/progress.component.ts",
    "src/app/utils/progress/progress.module.ts",
