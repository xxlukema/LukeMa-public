<?xml version="1.0" encoding="GB2312"?>
<!DOCTYPE hibernate-mapping PUBLIC
"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="com.learn.bean">
   <class name="Customer" lazy="false">
      <composite-id>
         <key-property name="ssn" length="9" />
      </composite-id>

      <version name="version" unsaved-value="negative" />

      <property name="name" length="18" unique="true" />

      <component name="address" class="Address">
         <property name="city" length="10" column="city" />

         <property name="state" length="2" />
      </component>

      <list name="selectedFeatures" cascade="all">
         <key column="ssn" />

         <index column="position" />

         <one-to-many class="SelectedFeature" />
      </list>
   </class>
</hibernate-mapping>

