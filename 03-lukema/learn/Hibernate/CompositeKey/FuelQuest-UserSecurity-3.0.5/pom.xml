<project xmlns="https://maven.apache.org/POM/4.0.0" xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
   <modelVersion>4.0.0</modelVersion>

   <groupId>com.learn</groupId>

   <artifactId>FuelQuest-UserSecurity-3.0.5</artifactId>

   <packaging>jar</packaging>

   <version>1.0</version>

   <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven.build.timestamp.format>yyyy-MM-dd'T'HH:mm:ss</maven.build.timestamp.format>
    <maven.test.skip>false</maven.test.skip>
    <maven.javadoc.skip>true</maven.javadoc.skip>
    <java.version>21</java.version>
    <maven.compiler.release>${java.version}</maven.compiler.release><!-- Java 9 and Beyond -->
    <maven.compiler.target>${java.version}</maven.compiler.target>
    <maven.compiler.source>${java.version}</maven.compiler.source>
    <!-- Other than boot -->
  </properties>

   <dependencies>
      <dependency>
         <groupId>org.hibernate</groupId>

         <artifactId>hibernate</artifactId>

         <version>3.2.5.ga</version>

<!--
         <version>3.0.5</version>         ========= column id not found exception at runtime.
         <version>3.1</version>           ========= scalar sequence messed up with this version of hibernate.
         <version>3.2.0.ga</version>      ========= scalar sequence get fixed with this version of hibernate.
         <version>3.2.5.ga</version>
-->
      </dependency>

      <dependency>
         <groupId>mysql</groupId>

         <artifactId>mysql-connector-java</artifactId>

         <version>8.0.30</version>
      </dependency>

      <dependency>
         <groupId>junit</groupId>

         <artifactId>junit</artifactId>

         <version>4.5</version>
      </dependency>
   </dependencies>

   <build>
      <plugins>
         <plugin>
            <artifactId>maven-compiler-plugin</artifactId>
         </plugin>

         <plugin>
            <artifactId>maven-antrun-plugin</artifactId>

            <executions>
               <execution>
                  <phase>generate-sources-skip</phase>

                  <configuration>
                     <tasks>
                        <path id="classpath">
                           <path refid="maven.compile.classpath" />

                           <path refid="maven.plugin.classpath" />
                        </path>

                        <taskdef name="hibernatetool" classname="org.hibernate.tool.ant.HibernateToolTask">
                           <classpath>
                              <path refid="classpath" />
                           </classpath>
                        </taskdef>

                        <hibernatetool destdir="target/generated">
                           <configuration configurationfile="src/main/resources/hibernate-donnot_use.cfg.xml">
                              <fileset dir="src/main/resources">
                                 <include name="**/*.hbm.xml" />
                              </fileset>
                           </configuration>

                           <hbm2java />
                        </hibernatetool>
                     </tasks>
                  </configuration>

                  <goals>
                     <goal>run</goal>
                  </goals>
               </execution>
            </executions>

            <dependencies>
               <dependency>
                  <groupId>org.hibernate</groupId>

                  <artifactId>hibernate-tools</artifactId>

                  <version>3.2.0.beta9a</version>
               </dependency>
            </dependencies>
         </plugin>
      </plugins>
   </build>
</project>
