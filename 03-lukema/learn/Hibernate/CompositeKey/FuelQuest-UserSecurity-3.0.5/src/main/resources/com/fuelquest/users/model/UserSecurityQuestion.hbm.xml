<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
   <class name="com.fuelquest.users.model.UserSecurityQuestion" table="USER_SECURITY_QUESTIONS">
      <id name="id" type="java.lang.Long">
         <column name="security_question_id" scale="0" />

         <generator class="native">
         </generator>
      </id>

      <property name="question" type="string">
         <column name="security_question" length="100" not-null="true" unique="true" />
      </property>

      <property name="groupingNumber" type="integer">
         <column name="question_group_number" />
      </property>

      <property name="sequenceInGroup" type="integer">
         <column name="sequence_in_group" />
      </property>
   </class>
</hibernate-mapping>

