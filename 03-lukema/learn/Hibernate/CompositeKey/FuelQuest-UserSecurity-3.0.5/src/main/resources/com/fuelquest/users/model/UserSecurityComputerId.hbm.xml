<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
   <class name="com.fuelquest.users.model.UserSecurityComputerId" table="USER_SECURITY_COMPUTER_IDENTIFIERS">
      <composite-id name="id" class="com.fuelquest.users.model.UserSecurityComputerIdPK">
         <key-many-to-one name="user" class="com.fuelquest.users.model.User">
            <column name="user_id" />
         </key-many-to-one>

         <key-property name="computerId">
            <column name="computer_identifier" length="100" not-null="true" />
         </key-property>
      </composite-id>
   </class>
</hibernate-mapping>

