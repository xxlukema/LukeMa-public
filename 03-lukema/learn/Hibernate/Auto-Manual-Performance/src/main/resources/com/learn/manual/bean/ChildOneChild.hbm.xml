<?xml version="1.0" encoding="GB2312"?>
<!DOCTYPE hibernate-mapping PUBLIC
"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-lazy="true" package="com.learn.manual.bean">
   <class name="ChildOneChild" table="Tmp_manual_ChildOneChild">
      <id name="id" column="childonechild_id">
         <generator class="native">
            <param name="sequence">ChildOneChild_Id_Seq</param>
         </generator>
      </id>

      <property name="name" unique="true" not-null="true" length="50" />

      <property name="parentId" column="childone_id" type="long" />
   </class>
   
   <query name="manual.childOneChild.findByParentId">from ChildOneChild where parentId = :parentId</query>
</hibernate-mapping>

