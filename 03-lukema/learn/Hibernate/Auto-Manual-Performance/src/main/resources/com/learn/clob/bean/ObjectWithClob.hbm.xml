<?xml version="1.0" encoding="GB2312"?>
<!DOCTYPE hibernate-mapping PUBLIC
"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="com.learn.clob.bean" default-lazy="true">
   <class name="ObjectWithClob" table="Tmp_clob_clob">
      <id name="id" column="id">
         <generator class="native">
            <param name="sequence">ObjectWithClob_Id_Seq</param>
         </generator>
      </id>

      <property name="clob" not-null="true" type="java.sql.Clob" />
   </class>
   
   <query name="objectWithClob.findAll">from ObjectWithClob</query>
   
   <query name="objectWithClob.like">from ObjectWithClob where clob like :key</query>
</hibernate-mapping>

