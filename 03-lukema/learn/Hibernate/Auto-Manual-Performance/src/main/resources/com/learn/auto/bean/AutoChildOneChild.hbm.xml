<?xml version="1.0" encoding="GB2312"?>
<!DOCTYPE hibernate-mapping PUBLIC
"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="com.learn.auto.bean" default-lazy="true">
   <class name="AutoChildOneChild" table="Tmp_auto_ChildOneChild">
      <id name="id" column="childonechild_id">
         <generator class="native">
            <param name="sequence">AutoChildOneChild_Id_Seq</param>
         </generator>
      </id>

      <property name="name" unique="true" not-null="true" length="50" />

      <many-to-one name="parent" column="childone_id" unique="true" not-null="true"/>
   </class>
</hibernate-mapping>

