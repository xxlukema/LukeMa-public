<?xml version="1.0" encoding="GB2312"?>
<!DOCTYPE hibernate-mapping PUBLIC
"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="com.learn.auto.bean" default-lazy="true">
   <class name="AutoChildOne" table="Tmp_auto_ChildOne">
      <id name="id" column="childone_id">
         <generator class="native">
            <param name="sequence">AutoChildOne_Id_Seq</param>
         </generator>
      </id>

      <property name="name" unique="true" not-null="true" length="50" />

      <many-to-one name="parent" column="parent_id" not-null="true" />
      
      <one-to-one name="child" class="AutoChildOneChild" property-ref="parent"/>
   </class>
</hibernate-mapping>

