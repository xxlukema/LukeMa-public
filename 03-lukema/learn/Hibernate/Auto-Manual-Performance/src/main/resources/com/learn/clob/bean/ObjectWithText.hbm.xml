<?xml version="1.0" encoding="GB2312"?>
<!DOCTYPE hibernate-mapping PUBLIC
"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="com.learn.clob.bean" default-lazy="true">
   <class name="ObjectWithText" table="Tmp_clob_text">
      <id name="id" column="id">
         <generator class="native">
            <param name="sequence">ObjectWithText_Id_Seq</param>
         </generator>
      </id>

      <property name="text" not-null="true" type="text" />
   </class>
   
   <query name="objectWithText.findAll">from ObjectWithText</query>
   
   <query name="objectWithText.like">from ObjectWithText where text like :key</query>
   
</hibernate-mapping>

