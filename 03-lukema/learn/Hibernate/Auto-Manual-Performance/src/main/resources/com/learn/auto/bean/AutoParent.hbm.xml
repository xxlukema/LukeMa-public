<?xml version="1.0" encoding="GB2312"?>
<!DOCTYPE hibernate-mapping PUBLIC
"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="com.learn.auto.bean" default-lazy="true">
   <class name="AutoParent" table="Tmp_auto_Parent" >
      <id name="id" column="parent_id">
         <generator class="native">
            <param name="sequence">AutoParent_Id_Seq</param>
         </generator>
      </id>

      <property name="name" unique="true" not-null="true" length="50" />

      <set name="childOneChildren" inverse="true">
         <key column="parent_id" />

         <one-to-many class="AutoChildOne" />
      </set>
      
      <one-to-one name="childTwo" property-ref="parent"/>
   </class>

   <query name="auto.parent.findAll">from AutoParent</query>
   
   <query name="auto.parent.like">from AutoParent where upper(name) like :key</query>
</hibernate-mapping>

