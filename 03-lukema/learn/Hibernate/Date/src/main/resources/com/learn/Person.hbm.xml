<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="com.learn" default-lazy="true">
   <class name="Person" table="People" >
      <id name="id" type="long" column="id">
         <generator class="native">
            <param name="sequence">Person_Id_Seq</param>
         </generator>
      </id>

      <property name="name" />
<!--                                                                         -->
<!-- If nap a Date to type="date", the millisecond data will be lost. To     -->
<!-- keep the millisecond field, map Date to type="java.util.Date".          -->
<!-- "date" is a reserved word in Oracle and thus it can not be used as      -->
<!-- a column name                                                           -->
      <property name="date" column="date_column" type="java.util.Date" />
   </class>
   
<!-- ">=" is sensitive to (MILI_SEC + 1000 * 3600 * 24) (24 hours)           -->
   <query name="person.findByDate">
      <![CDATA[
           from Person where date >= :date ]]>
   </query>
</hibernate-mapping>

