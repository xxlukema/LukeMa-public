   <bean id="dataSource" class="org.springframework.jdbc.datasource.DriverManagerDataSource" destroy-method="close">  
      <property name="driverClassName">
         <value>net.sourceforge.jtds.jdbc.Driver</value>
      </property>
       
      <property name="url">
         <value>jdbc:jtds:sybase://esssybd1.uk.db.com:5000;DatabaseName=ETS_ESS_TEST</value>
      </property>

      <property name="username">
         <value>ess_batch</value>
      </property>

      <property name="password">
         <value>ess_batch01</value>
      </property>
   </bean>
     
    <bean id="addressJTATarget" class="com.learn.jta.AddressJTAImpl">
      <property name="dataSource">
         <ref bean="dataSource" />
      </property>
   </bean>

   <bean id="addressJTA" parent="baseTransactionProxyFactoryBean">
      <property name="proxyInterfaces">
         <value>com.learn.jta.AddressJTA</value>
      </property>
   
      <property name="target">
         <ref bean="addressJTATarget" />
      </property>
   </bean>

    <bean id="addressJDBCTarget" class="com.learn.jdbc.AddressJDBCImpl">
      <property name="dataSource">
         <ref bean="dataSource" />
      </property>
   </bean>

   <bean id="addressJDBC" parent="baseTransactionProxyFactoryBean">
      <property name="proxyInterfaces">
         <value>com.learn.jdbc.AddressJDBC</value>
      </property>
   
      <property name="target">
         <ref bean="addressJDBCTarget" />
      </property>
   </bean>
   
   <bean id="baseTransactionProxyFactoryBean" class="org.springframework.transaction.interceptor.TransactionProxyFactoryBean">
      <property name="transactionManager">
         <ref bean="transactionManager" />
      </property>

      <property name="transactionAttributes">
         <props>
            <prop key="list*">PROPAGATION_REQUIRED,readOnly</prop>
         </props>
      </property>
   </bean>
     
   <bean id="transactionManager" class="org.springframework.jdbc.datasource.DataSourceTransactionManager">
      <property name="dataSource">
         <ref local="dataSource" />
      </property>
   </bean>

</beans>

