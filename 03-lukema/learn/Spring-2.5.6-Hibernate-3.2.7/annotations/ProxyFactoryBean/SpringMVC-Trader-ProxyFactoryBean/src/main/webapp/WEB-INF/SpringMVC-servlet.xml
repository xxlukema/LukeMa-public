<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE beans PUBLIC "-//SPRING//DTD BEAN//EN" "http://www.springframework.org/dtd/spring-beans.dtd">
<beans>

<!-- you can have more than one handler defined -->
   <bean id="urlMapping" class="org.springframework.web.servlet.handler.SimpleUrlHandlerMapping">
      <property name="urlMap">
         <map>
            <entry key="/logon.go">
               <ref bean="logonFormController" />
            </entry>

            <entry key="/portfolio.go">
               <ref bean="portfolioController" />
            </entry>

            <entry key="/trade.go">
               <ref bean="tradeFormController" />
            </entry>
         </map>
      </property>
   </bean>

   <bean id="logonFormController" class="com.learn.controller.LogonFormController">             
      <property name="sessionForm">
         <value>true</value>
      </property>

<!-- equivalent to form name in structs, or the JSF back bean. -->
      <property name="commandName">
         <value>credentials</value>
      </property>

<!-- The class of the back bean. -->
      <property name="commandClass">
         <value>com.learn.command.Credentials</value>
      </property>

      <property name="validator">
         <ref bean="logonValidator" />
      </property>

<!-- equivalent to "fail" navigation in JSP, or input page in struts. -->
      <property name="formView">
         <value>Logon</value>
      </property>

<!-- Action for "success" in struts, or navigation for "success" in JSF. -->
      <property name="successView">
         <value>portfolio.go</value>
      </property>
   </bean>

   <bean id="portfolioController" class="com.learn.controller.PortfolioController">
   </bean>

   <bean id="tradeFormController" class="com.learn.controller.TradeFormController">
   </bean>

   <bean id="logonValidator" class="com.learn.validator.LogonValidator" />

<!-- Common Settings -->
   <bean id="viewResolver" class="org.springframework.web.servlet.view.InternalResourceViewResolver">
      <property name="viewClass">
         <value>org.springframework.web.servlet.view.JstlView</value>
      </property>

      <property name="prefix">
         <value>/jsp/</value>
      </property>

      <property name="suffix">
         <value>.jsp</value>
      </property>
   </bean>

   <bean id="messageSource" class="org.springframework.context.support.ResourceBundleMessageSource">
      <property name="basename">
         <value>messages</value>
      </property>
   </bean>
</beans>

