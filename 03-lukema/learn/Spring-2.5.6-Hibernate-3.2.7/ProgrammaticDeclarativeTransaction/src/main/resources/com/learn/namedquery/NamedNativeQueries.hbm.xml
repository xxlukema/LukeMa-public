<?xml version="1.0" encoding="GB2312"?>
<!DOCTYPE hibernate-mapping PUBLIC
"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping default-lazy="true"
	package="com.learn.namedquery">

    <sql-query name="Account.findAccount">  
        <return-scalar column="cobDate" type="java.util.Date"/>
        <return-scalar column="accountNumber" type="java.lang.String"/>
        
        <![CDATA[
              select COB_DATE as cobDate, 
                     CH_ACCT_NBR as accountNumber
                from CS_CH_IA
               where SOURCE_FEED_NAME like :SOURCE_FEED_NAME
        ]]>
    </sql-query>
    
    <sql-query name="Account.updateAccount">  
        <![CDATA[
              update CS_CH_IA 
                 set UPDATE_DATETIME = :UPDATE_DATETIME
               where SOURCE_FEED_NAME = :SOURCE_FEED_NAME
                 and COB_DATE = :COB_DATE
                 and CH_ACCT_NBR = :CH_ACCT_NBR
        ]]>
    </sql-query>    
        	
</hibernate-mapping>

