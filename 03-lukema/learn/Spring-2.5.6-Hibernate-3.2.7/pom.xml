<project xmlns="https://maven.apache.org/POM/4.0.0" xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
   <modelVersion>4.0.0</modelVersion>

   <groupId>com.learn</groupId>

   <artifactId>Spring-Hibernate</artifactId>

   <packaging>pom</packaging>

   <version>1.0</version>

   <modules>
      <module>SpringUtils</module>

      <module>SpringBasic</module>

      <module>ProgrammaticDeclarativeTransaction</module>

      <module>Spring-jdbc</module>

      <module>TwoDataSourcesTwoPhaseCommit</module>
   </modules>

   <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven.build.timestamp.format>yyyy-MM-dd'T'HH:mm:ss</maven.build.timestamp.format>
    <maven.test.skip>false</maven.test.skip>
    <maven.javadoc.skip>true</maven.javadoc.skip>
    <java.version>21</java.version>
    <maven.compiler.release>${java.version}</maven.compiler.release><!-- Java 9 and Beyond -->
    <maven.compiler.target>${java.version}</maven.compiler.target>
    <maven.compiler.source>${java.version}</maven.compiler.source>
    <!-- Other than boot -->
  </properties>

   <dependencies>

      <dependency>
         <groupId>org.springframework</groupId>

         <artifactId>spring</artifactId>

         <version>5.3.25</version>
      </dependency>

      <dependency>
         <groupId>org.hibernate</groupId>

         <artifactId>hibernate</artifactId>

         <version>3.2.7.ga</version>
      </dependency>

      <dependency>
         <groupId>mysql</groupId>

         <artifactId>mysql-connector-java</artifactId>

         <version>8.0.30</version>
      </dependency>

      <dependency>
         <groupId>org.aspectj</groupId>

         <artifactId>aspectjweaver</artifactId>

         <version>1.6.9</version>
      </dependency>

      <dependency>
         <groupId>net.sourceforge.jtds</groupId>

         <artifactId>jtds</artifactId>

         <version>1.2.4</version>
      </dependency>

      <dependency>
         <groupId>com.oracle</groupId>

         <artifactId>ojdbc14</artifactId>

         <version>10.2.0.4</version>
      </dependency>

      <dependency>
         <groupId>junit</groupId>

         <artifactId>junit</artifactId>

         <version>4.13.2</version>
      </dependency>
   </dependencies>

   <build>
      <plugins>
         <plugin>
            <artifactId>maven-compiler-plugin</artifactId>
         </plugin>
      </plugins>
   </build>

   <reporting>
      <plugins>
         <plugin>
            <groupId>org.apache.maven.plugins</groupId>

            <artifactId>maven-surefire-report-plugin</artifactId>
         </plugin>
      </plugins>
   </reporting>
</project>
