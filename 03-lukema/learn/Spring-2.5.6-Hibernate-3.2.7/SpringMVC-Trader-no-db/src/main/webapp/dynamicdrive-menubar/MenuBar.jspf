
   <link rel="stylesheet" type="text/css" href="dynamicdrive-menubar/css/mystyle.css" />
   <script type="text/javascript" src="dynamicdrive-menubar/js/PopMenuLib.js"></script>

   <link rel="stylesheet" type="text/css" href="dynamicdrive-menubar/css/menubarstyle.css" />
   <script type="text/javascript" src="dynamicdrive-menubar/js/MyLib.js"></script>
   <script type="text/javascript" src="dynamicdrive-menubar/js/PopMenuData.js"></script>

   <table class="menubar" >
      <tr>
         <td>
            <a href="portfolio.go" onMouseover="this.style.backgroundColor='#FFFC17'; dropdownmenu(this, event, menu1, '150px');" onMouseout="this.style.backgroundColor='#6CC417'; delayhidemenu();">Portfolio</a> 
         </td>
         <td>
            <a href="trade.go" onMouseover="this.style.backgroundColor='#FFFC17'; dropdownmenu(this, event, menu2, '180px');" onMouseout="this.style.backgroundColor='#6CC417'; delayhidemenu();">Trade</a> 
         </td>
         <td>
            <a href="jsp/Logout.jsp" onMouseover="this.style.backgroundColor='#FFFC17'; dropdownmenu(this, event, logout, '80px');" onMouseout="this.style.backgroundColor='#6CC417'; delayhidemenu();">Logout</a> 
         </td>
      </tr>
   </table>

