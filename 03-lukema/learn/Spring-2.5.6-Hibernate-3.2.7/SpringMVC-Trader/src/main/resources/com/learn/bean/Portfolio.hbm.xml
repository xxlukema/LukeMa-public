<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="com.learn.bean" default-lazy="true" default-cascade="all-delete-orphan">
   <class name="Portfolio" table="Portfolio" >
      <id name="id" type="long" column="id">
         <generator class="native">
            <param name="sequence">Portfolio_Id_Seq</param>
         </generator>
      </id>
      
      <one-to-one name="customer" property-ref="portfolio"/>

      <property name="cash" />
      
      <bag name="portfolioItems" inverse="true" >
          <key column="portfolio_id"/>
          <one-to-many class="PortfolioItem"/>
      </bag>  

   </class>
</hibernate-mapping>

