    "test173": "npx playwright test -g \"API Auth ID Tests\"",
    "test173h": "npx playwright test -g \"API Auth ID Tests\" --headed",
    "test173u": "npx playwright test -g \"API Auth ID Tests\" --ui",
    "report": "npx playwright show-report",
    "list": "npx playwright test --list"
