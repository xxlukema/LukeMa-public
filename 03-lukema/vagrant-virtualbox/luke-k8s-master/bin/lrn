
if [ $# -eq 3 ]
then
   if [ "$2" = "-type" ]
   then
      files=`find . -name "*.${3}" | grep -v " " | grep -v target | grep -v /bin/ | grep -v metadata | grep -v build | grep -v classes`
   fi
elif [ $# -eq 1 ]
then
   files=`find . -type f | grep -v " " | grep -v target | grep -v /bin/ | grep -v metadata | grep -v build | grep -v classes`
else
   echo
   echo "      Usage: $0 str [-type fileType]"
   echo

   exit
fi

gg

   for i in $files
   do
      grep -i "$1" $i > /dev/null

      if [ $? -eq 0 ]
      then
         echo -------------------------------------------------------------
         echo $i

         grep -i "$1" $i
      fi
   done

echo
echo



