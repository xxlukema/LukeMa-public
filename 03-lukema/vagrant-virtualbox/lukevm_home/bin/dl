
if [ $# -lt 2 -o $# -gt 3 ]
then
   echo
   echo "Usage: $0 lineNumber1 [lineNumber2] fileName"
   echo

   exit 1
fi


if [ $# -eq 2 ]
then
   lineNumber1=$1
   lineNumber2=1
   fileName=$2
else
   lineNumber1=$2
   lineNumber2=`expr $2 - $1 + 1`
   fileName=$3
fi

if [ ! -f $fileName ]
then
   echo
   echo "ERROR: File not found: $fileName"
   echo

   exit 1
fi

head -$lineNumber1 $fileName | tail -$lineNumber2


